    "Adjusts playback volume so tracks and albums sound equally loud, using ReplayGain tags from your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt die Wiedergabelautstärke an, damit Titel und Alben gleich laut klingen, basierend auf ReplayGain-Tags aus deiner Mediathek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулирует громкость воспроизведения, чтобы треки и альбомы звучали одинаково громко, используя теги ReplayGain из вашей медиатеки."
          }
        }
      }
    },
