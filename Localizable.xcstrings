    "Downloads" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки"
          }
        }
      }
    },
    "Downloads every track to this device before playing it, instead of streaming, so transitions have no gap even over a transcoded or slow connection. A track not played again within the limit above is automatically removed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузка песен перед воспроизведением для бесшовного перехода при транскодировании или слабом соединении. Песни, не воспроизводимые в течение указанного времени, удаляются автоматически."
          }
        }
      }
    },
